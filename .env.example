# K3s-ArgoCD Sandbox - Local Configuration
# Copy to .env and edit. This is the single source of truth: `make configure`
# reads it and regenerates the Kustomize mirror files under apps/ and argocd/.
# 🚨 NEVER commit the actual '.env' file to version control!

# 🌍 Runtime
# APP_DOMAIN drives every *_HOST value (e.g. grafana.$APP_DOMAIN) via
# `make configure` - you don't set the *_HOST values directly.
# - Local laptop: 127.0.0.1.nip.io
# - Remote VM: <VM_PUBLIC_IP>.nip.io
APP_DOMAIN=127.0.0.1.nip.io

# REPO_URL/TARGET_REVISION must be reachable both from the shell running
# `make bootstrap` and from ArgoCD inside the cluster. Point this at your
# fork if you're customizing the lab.
REPO_URL=https://github.com/chinmaymjog/k3s-argocd-sandbox.git
TARGET_REVISION=main

# 📦 Pinned Image References
ADMINER_IMAGE=adminer:5.4.2
GRAFANA_IMAGE=grafana/grafana-oss:13.0.1
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:24.0.0
MYSQL_IMAGE=mysql:8.0
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.18.7
PGSQL_IMAGE=postgres:15
PHPMYADMIN_IMAGE=phpmyadmin:5.2.3
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3

# 🐘 PostgreSQL Database
POSTGRES_PASSWORD=postgres_secure_password
N8N_DB_PASSWORD=n8n_secure_db_password
GRAFANA_DB_PASSWORD=grafana_secure_db_password

# 🐬 MySQL Database
MYSQL_ROOT_PASSWORD=mysql_secure_root_password

# ⚙️ Automation (n8n)
# Encryption key for n8n credentials (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# 🔑 Keycloak
KEYCLOAK_ADMIN_PASSWORD=keycloak_secure_admin_password
KEYCLOAK_DB_PASSWORD=keycloak_secure_db_password

# 🔌 Optional (defaults shown; uncomment to override)
# ROLLOUT_TIMEOUT=900s
# SKIP_REPO_ACCESS_CHECK=false
